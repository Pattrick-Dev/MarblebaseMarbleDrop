<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<groupId>me.pattrick</groupId>
	<artifactId>MarbleDropPlugin</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>MarbleDropPlugin</name>

	<properties>
		<!-- Paper 26.2 targets Java 25 -->
		<java.version>25</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<paper.api.version>26.2.build.39-alpha</paper.api.version>
	</properties>

	<repositories>
		<!-- PaperMC Maven repo (Paper API, etc.) -->
		<repository>
			<id>papermc</id>
			<url>https://repo.papermc.io/repository/maven-public/</url>
		</repository>

		<!-- Keep Mojang libraries repo only if you truly need authlib -->
		<repository>
			<id>minecraft-repo</id>
			<url>https://libraries.minecraft.net/</url>
		</repository>

		<!-- EngineHub (WorldEdit); FAWE is API-compatible with worldedit-bukkit -->
		<repository>
			<id>enginehub-maven</id>
			<url>https://maven.enginehub.org/repo/</url>
		</repository>
	</repositories>

	<dependencies>
		<!-- Compile against Paper API (provided by the server at runtime) -->
		<dependency>
			<groupId>io.papermc.paper</groupId>
			<artifactId>paper-api</artifactId>
			<version>${paper.api.version}</version>
			<scope>provided</scope>
		</dependency>

		<!-- Optional: only used by TutorialCraftFrameManager.setupFromSelection
		     to read an admin's WorldEdit/FAWE selection. provided scope;
		     supplied at runtime by WorldEdit or FAWE, not bundled in our jar.
		     Nothing else in the plugin references these classes, so the
		     plugin loads and runs fine even if neither is installed. -->
		<dependency>
			<groupId>com.sk89q.worldedit</groupId>
			<artifactId>worldedit-bukkit</artifactId>
			<version>7.4.0</version>
			<scope>provided</scope>
		</dependency>

		<!-- 2D physics for marble/track collision (races/). Zero transitive deps, shaded below. -->
		<dependency>
			<groupId>org.dyn4j</groupId>
			<artifactId>dyn4j</artifactId>
			<version>5.0.2</version>
		</dependency>

	</dependencies>

	<build>
		<finalName>MarblebaseDrop</finalName>
		<sourceDirectory>src/main/java</sourceDirectory>

		<plugins>
			<!-- Modern compiler plugin + Java 21 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<source>${java.version}</source>
					<target>${java.version}</target>
				</configuration>
			</plugin>

			<!-- Bundle dyn4j into the plugin jar (Paper doesn't provide it) and relocate
			     it so it can't collide with another plugin shading a different version. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<relocations>
								<relocation>
									<pattern>org.dyn4j</pattern>
									<shadedPattern>me.pattrick.marbledrop.libs.dyn4j</shadedPattern>
								</relocation>
							</relocations>
						</configuration>
					</execution>
				</executions>
			</plugin>

		</plugins>

		<resources>
			<resource>
				<filtering>true</filtering>
				<directory>src/main/resources</directory>
				<includes>
					<include>plugin.yml</include>
					<include>heads.yml</include>
					<include>config.yml</include>
					<include>cooldowns.yml</include>
				</includes>
			</resource>
			</resources>
	</build>

</project>
